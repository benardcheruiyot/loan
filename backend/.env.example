# Backend configuration template
NODE_ENV=development
PORT=5000


# Comma-separated frontend origins. Use exact origins in production.
ALLOWED_ORIGINS=https://your-new-frontend.example.com


# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Payment Provider Selection
# Options: hashpay or daraja
PAYMENT_PROVIDER=daraja

# Hashpay configuration (use if PAYMENT_PROVIDER=hashpay)
HASHPAY_API_KEY=replace_with_hashpay_api_key
HASHPAY_API_SECRET=replace_with_hashpay_api_secret
HASHPAY_ENVIRONMENT=production
HASHPAY_BASE_URL=https://api.hashpay.co.ke
HASHPAY_CALLBACK_URL=https://your-new-backend.example.com/api/payments/callback

# Daraja M-Pesa API configuration (use if PAYMENT_PROVIDER=daraja)
DARAJA_CONSUMER_KEY=replace_with_daraja_consumer_key
DARAJA_CONSUMER_SECRET=replace_with_daraja_consumer_secret
DARAJA_BUSINESS_SHORTCODE=replace_with_business_shortcode
DARAJA_PARTYB_SHORTCODE=replace_with_partyb_shortcode
DARAJA_PASSKEY=replace_with_daraja_passkey
DARAJA_CALLBACK_URL=https://your-new-backend.example.com/api/payments/callback
DARAJA_ENVIRONMENT=production
# Optional labels sent with the STK request
DARAJA_ACCOUNT_REFERENCE=YourApp
DARAJA_TRANSACTION_DESCRIPTION=Payment for loan processing
# Daraja timeout for STK push (in seconds)
DARAJA_TIMEOUT=60

# Web Push VAPID
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Optional app metadata for notifications
APP_NAME=Your App Name
APP_PUBLIC_URL=https://your-new-backend.example.com

# Loan settings
LOAN_MIN_AMOUNT=5500
LOAN_MAX_AMOUNT=150000
LOAN_INTEREST_RATE=0.1
LOAN_TERMS_DAYS=30,60,90
PROCESSING_FEE=120
PROCESSING_FEE_MIN=120
PROCESSING_FEE_MAX=3500

# Email (optional)
EMAIL_SERVICE=gmail
EMAIL_FROM=noreply@your-new-domain.example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logging / security
LOG_LEVEL=info
# Note: Pending transactions automatically expire after 5 minutes (300000ms)
# This allows users to retry STK push requests without blocking
